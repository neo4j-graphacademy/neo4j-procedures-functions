{
  "name": "Neo4j procedures and functions",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "false"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "./scripts/setup-neo4j.sh && ./mvnw -B -q dependency:go-offline",
  "postStartCommand": "./scripts/setup-neo4j.sh",
  "forwardPorts": [
    7474,
    7687
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  }
}
